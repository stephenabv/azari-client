# .env.example
# Copy this file to .env and fill in the values for local development

# Secure admin route (must match VITE_ADMIN_ROUTE in deployment)
VITE_ADMIN_ROUTE=

# SSR server: absolute URL to the azari-service backend (used in server-side loaders)
API_URL=http://localhost:4000

# Port for the SSR server (react-router-serve)
PORT=3000
